@Simplia.Api_HostAddress = http://localhost:5278

GET {{Simplia.Api_HostAddress}}/health/live
Accept: application/json

###

POST {{Simplia.Api_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "admin@dev.local",
  "password": "Admin123!"
}

###

# Paste the refreshToken returned by login.
POST {{Simplia.Api_HostAddress}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###

POST {{Simplia.Api_HostAddress}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}
