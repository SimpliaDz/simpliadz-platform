<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Simplia.Identity.Core\Simplia.Identity.Core.csproj" />
    <ProjectReference Include="..\..\..\Simplia.BuildingBlocks\Simplia.BuildingBlocks.csproj" />
    <ProjectReference Include="..\Simplia.Identity.UseCases\Simplia.Identity.UseCases.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.2" />
